<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyTitle>Translate Demo Browser</AssemblyTitle>
    <!-- translatekit.dll built by ../translate-kit-windows/scripts/build-windows.ps1 -->
    <TranslateKitDll>$(MSBuildThisFileDirectory)..\translate-kit-windows\build\windows\translatekit.dll</TranslateKitDll>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CefSharp.WinForms.NETCore" Version="152.0.100" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="page.js" />
    <None Include="$(TranslateKitDll)" Link="translatekit.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
